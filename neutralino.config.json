{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "io.stalink.hub",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "tokenSecurity": "none",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "debug.log",
    "events.*",
    "extensions.*"
  ],
  "extensions": [
    {
      "id": "js.neutralino.installer",
      "command": "node ${NL_PATH}/extensions/installer_wrapper/extension.js"
    }
  ],
  "modes": {
    "window": {
      "title": "StaLink Command Center",
      "width": 1000,
      "height": 720,
      "minWidth": 800,
      "minHeight": 600,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/icons/appIcon.png",
      "enableInspector": true,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false
    },
    "browser": {
      "nativeBlockList": [
        "filesystem.*"
      ]
    },
    "cloud": {
      "url": "/dist/#cloud",
      "nativeAllowList": [
        "app.*"
      ]
    },
    "chrome": {
      "width": 1000,
      "height": 720,
      "args": "--user-agent=\"Neutralinojs chrome mode\"",
      "nativeBlockList": [
        "filesystem.*",
        "os.*"
      ]
    }
  },
  "cli": {
    "binaryName": "stalink",
    "resourcesPath": "/dist",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/dist/js/neutralino.js",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0",
    "frontendLibrary": {
      "projectPath": "/",
      "devUrl": "http://localhost:5173",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build"
    }
  }
}